-- {{ ansible_managed }}
-- Läuft nur beim allerersten Start des PostgreSQL-Containers.

-- Keycloak
CREATE ROLE keycloak WITH LOGIN PASSWORD '{{ passwords.keycloak_db }}';
CREATE DATABASE keycloak OWNER keycloak;

-- Vault Database Secrets Engine: darf temporäre Rollen anlegen
CREATE ROLE vault WITH LOGIN CREATEROLE PASSWORD '{{ passwords.postgres_vault }}';
CREATE DATABASE fachverfahren OWNER vault;

\connect fachverfahren

CREATE TABLE antraege (
  id          serial PRIMARY KEY,
  aktenzeichen text NOT NULL,
  antragsart  text NOT NULL,
  status      text NOT NULL,
  eingang     date NOT NULL
);

