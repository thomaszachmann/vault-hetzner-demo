{% raw %}{
  "title": "Vault Demo – Cluster & Audit",
  "uid": "vault-demo",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "type": "stat", "title": "Nodes erreichbar", "gridPos": { "x": 0, "y": 0, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum by (site) (up{job=\"vault\"})", "legendFormat": "{{site}}" }],
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat", "title": "Entsiegelt (unsealed)", "gridPos": { "x": 6, "y": 0, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum by (site) (vault_core_unsealed)", "legendFormat": "{{site}}" }],
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "table", "title": "Aktiver Node je Standort", "gridPos": { "x": 12, "y": 0, "w": 12, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "vault_core_active == 1", "format": "table", "instant": true }],
      "transformations": [{ "id": "organize", "options": { "includeByName": { "site": true, "instance": true } } }]
    },
    {
      "type": "timeseries", "title": "Requests pro Sekunde", "gridPos": { "x": 0, "y": 5, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum by (site) (rate(vault_core_handle_request_count[1m]))", "legendFormat": "{{site}}" }]
    },
    {
      "type": "timeseries", "title": "Raft-Commit-Dauer (ms)", "gridPos": { "x": 12, "y": 5, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "max by (site) (vault_raft_commitTime{quantile=\"0.99\"})", "legendFormat": "{{site}} p99" }]
    },
    {
      "type": "logs", "title": "Audit-Log (alle Nodes)", "gridPos": { "x": 0, "y": 13, "w": 24, "h": 12 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{ "expr": "{namespace=\"vault\", container=\"vault\"} | json | __error__=\"\" | type=\"response\" | line_format \"{{.site}} {{.pod}} {{.request_operation}} {{.request_namespace_path}}{{.request_path}} {{.auth_display_name}} {{.error}}\"" }],
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending" }
    }
  ]
}
{% endraw %}
