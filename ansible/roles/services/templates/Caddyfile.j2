# {{ ansible_managed }}
# Zertifikat der Demo-Root-CA (kein ACME: die Dienste sind nicht öffentlich erreichbar)
(demo_tls) {
	tls /certs/services.pem /certs/services.key
}

https://keycloak.{{ nip }} {
	import demo_tls
	reverse_proxy keycloak:8080
}

https://grafana.{{ nip }} {
	import demo_tls
	reverse_proxy grafana:3000
}

https://prometheus.{{ nip }} {
	import demo_tls
	reverse_proxy prometheus:9090
}
